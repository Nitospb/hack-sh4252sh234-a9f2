# Server-side secrets only. Copy to .env; never commit the completed file.
ALFA_API_KEY=
ALFA_BASE_URL=https://changellenge.up.railway.app/v1
ALFA_MODEL=qwen/qwen3.6-35b-a3b
ALFA_MAX_CALLS_PER_DAY=30
ALFA_MAX_TOKENS_PER_DAY=300000
# Loopback prototype default. Before remote deployment use authenticated TLS ingress.
ALFA_WEB_PORT=3000
# Set 1 to reject synthetic fallback when full assets are missing.
ALFA_REQUIRE_FULL=0
